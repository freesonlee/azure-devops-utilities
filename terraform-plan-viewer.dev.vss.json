{
  "manifestVersion": 1,
  "id": "ads-terraform-plan-viewer-dev",
  "publisher": "FreesonLi",
  "version": "0.0.3",
  "name": "Terraform Plan Viewer (Dev)",
  "description": "Private localhost development extension for Terraform pipeline run plans.",
  "public": false,
  "scopes": [
    "vso.build"
  ],
  "icons": {
    "default": "images/terraform-plan-viewer.png"
  },
  "categories": [
    "Azure Pipelines"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "content": {
    "details": {
      "path": "src/app/terraform-plan-viewer-extension/readme.md"
    }
  },
  "contributions": [
    {
      "id": "fl.terraform-plans.run-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "targets": [
        "ms.vss-build-web.build-results-view"
      ],
      "properties": {
        "name": "Terraform Plans (Dev)",
        "uri": "index.html",
        "supportsTasks": [
          "84d7f344-97f7-4696-8708-125d20e556ba"
        ]
      }
    },
    {
      "id": "publish-terraform-plan-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist/tasks/PublishTerraformPlanDev"
      }
    }
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/freesonlee/azure-devops-utilities"
  },
  "files": [
    {
      "path": "dist/tasks/PublishTerraformPlanDev"
    }
  ],
  "baseUri": "https://localhost:4302/"
}
