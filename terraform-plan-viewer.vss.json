{
  "manifestVersion": 1,
  "id": "ads-terraform-plan-viewer",
  "publisher": "FreesonLi",
  "version": "0.2.0",
  "name": "Terraform Plan Viewer",
  "description": "View Terraform plan JSON files from pipeline run artifacts.",
  "public": true,
  "scopes": [
    "vso.build"
  ],
  "icons": {
    "default": "images/terraform-plan-viewer.png"
  },
  "categories": [
    "Azure Pipelines"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "content": {
    "details": {
      "path": "src/app/terraform-plan-viewer-extension/readme.md"
    }
  },
  "contributions": [
    {
      "id": "fl.terraform-plans.run-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "targets": [
        "ms.vss-build-web.build-results-view"
      ],
      "properties": {
        "name": "Terraform Plans",
        "uri": "index.html",
        "supportsTasks": [
          "98e926ad-675f-42d3-8b3b-3b04127102f5"
        ]
      }
    },
    {
      "id": "publish-terraform-plan-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist/tasks/PublishTerraformPlan"
      }
    }
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/freesonlee/azure-devops-utilities"
  },
  "files": [
    {
      "path": "dist/azure-devops-terraform-plan-viewer-extension",
      "packagePath": "/",
      "addressable": true
    },
    {
      "path": "dist/tasks/PublishTerraformPlan"
    }
  ],
  "links": {
    "support": {
      "uri": "https://github.com/freesonlee/azure-devops-utilities/issues"
    }
  }
}
