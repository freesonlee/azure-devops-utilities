{
  "name": "azure-devops-variable-group-editor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:viewer",
    "start": "ng serve azure-devops-variable-group-editor",
    "prebuild": "npm run build:viewer",
    "build": "ng build azure-devops-variable-group-editor",
    "watch": "ng build azure-devops-variable-group-editor --watch --configuration development",
    "build:viewer": "ng build terraform-plan-viewer --configuration production",
    "watch:viewer": "ng build terraform-plan-viewer --watch --configuration development",
    "test:viewer": "ng test terraform-plan-viewer --watch=false --browsers=ChromiumHeadless",
    "capture:viewer": "node scripts/capture-terraform-viewer.cjs",
    "pack:viewer": "npm run build:viewer && node scripts/pack-viewer.cjs",
    "verify:viewer-package": "node scripts/verify-viewer-package.cjs",
    "test": "ng test",
    "ui:check": "node scripts/check-variable-editor.cjs",
    "ui:check:profiles": "node scripts/check-pipeline-profiles.cjs",
    "deploy": "scp -r ./dist/azure-devops-variable-group-editor freeson@192.168.1.187:~/azure-devops-utilities",
    "build-h": "ng build azure-devops-variable-group-history-extension",
    "build-p": "ng build azure-devops-pipeline-profiles",
    "pack-history": "node scripts/public-extension.cjs pack history",
    "pack-pipeline": "node scripts/public-extension.cjs pack pipeline",
    "publish-history": "node scripts/public-extension.cjs publish history",
    "publish-pipeline": "node scripts/public-extension.cjs publish pipeline",
    "dev:cert": "node scripts/create-dev-certificate.cjs",
    "start-history-dev": "npm run dev:cert && ng serve azure-devops-variable-group-history-extension --configuration development --host localhost --port 4300 --ssl --ssl-cert .certs/localhost.pem --ssl-key .certs/localhost-key.pem",
    "start-pipeline-dev": "npm run dev:cert && ng serve azure-devops-pipeline-profiles --configuration development --host localhost --port 4301 --ssl --ssl-cert .certs/localhost.pem --ssl-key .certs/localhost-key.pem",
    "pack-history-dev": "node scripts/dev-extension.cjs pack history",
    "pack-pipeline-dev": "node scripts/dev-extension.cjs pack pipeline",
    "pack-dev": "npm run pack-history-dev && npm run pack-pipeline-dev && npm run pack-terraform-dev",
    "publish-history-dev": "node scripts/dev-extension.cjs publish history",
    "publish-pipeline-dev": "node scripts/dev-extension.cjs publish pipeline",
    "install-history-dev": "node scripts/dev-extension.cjs install history",
    "install-pipeline-dev": "node scripts/dev-extension.cjs install pipeline",
    "build:extensions": "npm run build-h && npm run build-p && npm run build-t",
    "build:all": "npm run build && npm run build:extensions",
    "ui:check:extensions": "node scripts/check-extensions.cjs",
    "ui:check:website": "node scripts/check-website-build.cjs",
    "test:website": "ng test azure-devops-variable-group-editor --watch=false --karma-config projects/terraform-plan-viewer/karma.conf.cjs --browsers ChromiumHeadless",
    "build:terraform-task": "node scripts/build-terraform-task.cjs",
    "test:terraform-task": "node --test tasks/PublishTerraformPlan/task.test.cjs",
    "prebuild-t": "npm run build:viewer && npm run build:terraform-task",
    "build-t": "ng build azure-devops-terraform-plan-viewer-extension",
    "test:terraform-extension": "ng test azure-devops-terraform-plan-viewer-extension --watch=false --browsers ChromiumHeadless",
    "prestart-terraform-dev": "ng build terraform-plan-viewer --configuration development",
    "start-terraform-dev": "npm run dev:cert && ng serve azure-devops-terraform-plan-viewer-extension --configuration development --host localhost --port 4302 --ssl --ssl-cert .certs/localhost.pem --ssl-key .certs/localhost-key.pem",
    "pack-terraform": "node scripts/public-extension.cjs pack terraform",
    "pack-terraform-dev": "node scripts/dev-extension.cjs pack terraform",
    "publish-terraform-dev": "node scripts/dev-extension.cjs publish terraform",
    "install-terraform-dev": "node scripts/dev-extension.cjs install terraform",
    "ui:check:terraform-extension": "node scripts/check-terraform-extension.cjs",
    "verify-history-public": "node scripts/public-extension.cjs verify history",
    "install-history-public": "node scripts/public-extension.cjs install history",
    "verify-pipeline-public": "node scripts/public-extension.cjs verify pipeline",
    "install-pipeline-public": "node scripts/public-extension.cjs install pipeline",
    "publish-terraform": "node scripts/public-extension.cjs publish terraform",
    "verify-terraform-public": "node scripts/public-extension.cjs verify terraform",
    "install-terraform-public": "node scripts/public-extension.cjs install terraform",
    "pages:prepare": "node scripts/prepare-pages.cjs",
    "publish-public": "npm run publish-history && npm run publish-pipeline && npm run publish-terraform",
    "verify-public": "npm run verify-history-public && npm run verify-pipeline-public && npm run verify-terraform-public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.1.1",
    "@angular/cdk": "^17.1.1",
    "@angular/common": "^17.1.1",
    "@angular/compiler": "^17.1.1",
    "@angular/core": "^17.1.1",
    "@angular/forms": "^17.1.1",
    "@angular/material": "^17.1.1",
    "@angular/platform-browser": "^17.1.1",
    "@angular/platform-browser-dynamic": "^17.1.1",
    "@angular/router": "^17.1.1",
    "@types/diff": "^8.0.0",
    "azure-devops-extension-api": "^2.225.0",
    "azure-devops-extension-sdk": "^3.1.2",
    "diff": "^8.0.2",
    "js-yaml": "^4.1.0",
    "jszip": "3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^17.0.0",
    "@angular-devkit/build-angular": "^17.1.1",
    "@angular/cli": "~17.1.1",
    "@angular/compiler-cli": "^17.1.1",
    "@fontsource/roboto": "5.3.0",
    "@material-design-icons/svg": "^0.14.15",
    "@types/jasmine": "~4.3.0",
    "@types/js-yaml": "^4.0.5",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "material-icons": "1.13.14",
    "ng-packagr": "^17.1.2",
    "playwright": "^1.64.0",
    "tfx-cli": "0.24.2",
    "typescript": "~5.3.3"
  }
}
