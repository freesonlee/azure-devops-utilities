{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "azure-devops-variable-group-editor": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/azure-devops-variable-group-editor",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "30kb"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "azure-devops-variable-group-editor:build:production"
            },
            "development": {
              "buildTarget": "azure-devops-variable-group-editor:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "azure-devops-variable-group-editor:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.css"
            ],
            "scripts": [],
            "exclude": [
              "src/app/pipeline-profiles/**/*.spec.ts",
              "src/app/variable-group-history/**/*.spec.ts",
              "src/app/terraform-plan-viewer-extension/**/*.spec.ts"
            ]
          }
        }
      }
    },
    "terraform-plan-viewer": {
      "projectType": "library",
      "root": "projects/terraform-plan-viewer",
      "sourceRoot": "projects/terraform-plan-viewer/src",
      "prefix": "tf",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/terraform-plan-viewer/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/terraform-plan-viewer/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/terraform-plan-viewer/tsconfig.lib.json",
              "project": "projects/terraform-plan-viewer/ng-package.development.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/terraform-plan-viewer/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "karmaConfig": "projects/terraform-plan-viewer/karma.conf.cjs",
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css"
            ]
          }
        }
      }
    },
    "azure-devops-variable-group-history-extension": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src/app/variable-group-history",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist/azure-devops-variable-group-history-extension",
            "index": "src/app/variable-group-history/index.html",
            "main": "src/app/variable-group-history/main.ts",
            "customWebpackConfig": {
              "path": "./webpack.config.js"
            },
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.varhistory.json",
            "assets": [],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/app/variable-group-history/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "18kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "azure-devops-variable-group-history-extension:build:production"
            },
            "development": {
              "buildTarget": "azure-devops-variable-group-history-extension:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "azure-devops-variable-group-history-extension:build"
          }
        }
      }
    },
    "azure-devops-pipeline-profiles": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src/app/pipeline-profiles",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist/azure-devops-pipeline-profiles",
            "index": "src/app/pipeline-profiles/index.html",
            "main": "src/app/pipeline-profiles/main.ts",
            "customWebpackConfig": {
              "path": "./webpack.config.js"
            },
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.pp.json",
            "assets": [],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/app/pipeline-profiles/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "14kb",
                  "maximumError": "16kb"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "azure-devops-pipeline-profiles:build:production"
            },
            "development": {
              "buildTarget": "azure-devops-pipeline-profiles:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "azure-devops-pipeline-profiles:build"
          }
        }
      }
    },
    "azure-devops-terraform-plan-viewer-extension": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src/app/terraform-plan-viewer-extension",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist/azure-devops-terraform-plan-viewer-extension",
            "index": "src/app/terraform-plan-viewer-extension/index.html",
            "main": "src/app/terraform-plan-viewer-extension/main.ts",
            "customWebpackConfig": {
              "path": "./webpack.config.js"
            },
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.terraform-extension.json",
            "assets": [],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/app/terraform-plan-viewer-extension/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1800kb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "30kb"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "azure-devops-terraform-plan-viewer-extension:build:production"
            },
            "development": {
              "buildTarget": "azure-devops-terraform-plan-viewer-extension:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "azure-devops-terraform-plan-viewer-extension:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.terraform-extension.spec.json",
            "karmaConfig": "projects/terraform-plan-viewer/karma.conf.cjs",
            "assets": [],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/app/terraform-plan-viewer-extension/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
