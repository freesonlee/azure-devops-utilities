{
    "manifestVersion": 1,
    "id": "ads-pipeline-profiles-dev",
    "publisher": "FreesonLi",
    "version": "0.0.1",
    "name": "Pipeline Profiles (Dev)",
    "description": "Private localhost development extension for Pipeline Profiles.",
    "public": false,
    "scopes": [
        "vso.build_execute",
        "vso.code"
    ],
    "icons": {
        "default": "images/pipelineprofiles.png"
    },
    "categories": [
        "Azure Pipelines"
    ],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "content": {
        "details": {
            "path": "./src/app/pipeline-profiles/readme.md"
        }
    },
    "contributions": [
        {
            "id": "fl.pipeline-profiles.hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-build-web.build-release-hub-group"
            ],
            "properties": {
                "name": "Pipeline Profiles (Dev)",
                "iconName": "Car",
                "uri": "index.html"
            }
        }
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/freesonlee/azure-devops-utilities/tree/vs-extension"
    },
    "files": [],
    "baseUri": "https://localhost:4301/"
}
